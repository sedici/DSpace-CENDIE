<dspace-dc-types>

  <dspace-header>
		<title>Metadatos - CENDIE 2025</title>
		<contributor.author>CENDIE Team</contributor.author>
	</dspace-header>

  <!-- Schemas -->
	<dc-schema>
		<name>cendie</name>
		<namespace>https://abc.gob.ar/namespace/cendie</namespace>
	</dc-schema>

  <dc-type>
    <schema>cendie</schema>
    <element>type</element>
    <scope_note>Tipo (específico) del documento</scope_note>
  </dc-type>
  <dc-type>
    <schema>cendie</schema>
    <element>subject</element>
    <qualifier>materia</qualifier>
    <scope_note>Materia asociada al documento</scope_note>
  </dc-type>
  <dc-type>
    <schema>cendie</schema>
    <element>contributor</element>
    <qualifier>inscriber</qualifier>
    <scope_note>Firmantes</scope_note>
  </dc-type>
  <dc-type>
    <schema>cendie</schema>
    <element>contributor</element>
    <qualifier>corporate</qualifier>
    <scope_note>Autor (institución) del documento</scope_note>
  </dc-type>
  <dc-type>
    <schema>cendie</schema>
    <element>contributor</element>
    <qualifier>gobernador</qualifier>
    <scope_note></scope_note>
  </dc-type>
  <dc-type>
    <schema>cendie</schema>
    <element>contributor</element>
    <qualifier>director</qualifier>
    <scope_note></scope_note>
  </dc-type>
  <dc-type>
    <schema>cendie</schema>
    <element>identifier</element>
    <qualifier>normativa</qualifier>
    <scope_note></scope_note>
  </dc-type>
  <dc-type>
		<schema>dc</schema>
		<element>title</element>
		<qualifier>subtitle</qualifier>
		<scope_note>Subtítulo del recurso</scope_note>
	</dc-type>
  <dc-type>
		<schema>dc</schema>
		<element>description</element>
		<qualifier>note</qualifier>
		<scope_note>Notas adicionales sobre el recurso</scope_note>
	</dc-type>
  <dc-type>
		<schema>dc</schema>
		<element>description</element>
		<qualifier>filiation</qualifier>
		<scope_note>Filiación institucional del autor</scope_note>
	</dc-type>
  <dc-type>
		<schema>dc</schema>
		<element>coverage</element>
		<scope_note>Alcance</scope_note>
	</dc-type>
  <dc-type>
		<schema>cendie</schema>
		<element>relation</element>
		<qualifier>isRelatedWith</qualifier>
		<scope_note>URL de documentos relacionados</scope_note>
	</dc-type>
  <dc-type>
		<schema>dc</schema>
		<element>relation</element>
		<qualifier>external</qualifier>
		<scope_note>URL externa relacionada al documento</scope_note>
	</dc-type>
  <dc-type>
		<schema>dc</schema>
		<element>audience</element>
		<qualifier>educationLevel</qualifier>
		<scope_note>Nivel educativo al que está dirigido el recurso</scope_note>
	</dc-type>
  
